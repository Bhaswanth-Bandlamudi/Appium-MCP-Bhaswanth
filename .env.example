# Copy the variables you need into your MCP client's server configuration (or your shell).
# Never commit a file that contains real values. This file has placeholders only.

# --- Local Android -----------------------------------------------------------
# ANDROID_HOME=C:\Users\you\AppData\Local\Android\Sdk
# ANDROID_SDK_ROOT=

# --- Token use ----------------------------------------------------------------
# Which tool groups are registered. Every registered tool's definition is sent to the model each session.
#   unset              default set: all upstream tools plus the core additions (qa and providers hidden)
#   default,qa         default plus exploration, workflows, visual and accessibility checks, UI diff, scenarios, network
#   default,providers  default plus the cloud provider tools
#   all                every tool
#   core,observe       exactly these groups
# Groups: core, observe, interact, locators, device, advanced, ios (default); qa, providers (opt-in).
# APPIUM_MCP_TOOL_GROUPS=default,providers

# --- Safety -------------------------------------------------------------------
# Destructive operations (uninstall, clear app data, fullReset, file push, app upload) need a confirmation
# token. This is ON by default and there is no global switch to turn it off.
# Trusted automation mode skips the confirmation ONLY for the operations and apps listed here. It is OFF unless
# all four variables are set and valid. Any mistake leaves the confirmation ON. Every bypass is logged.
# APPIUM_MCP_TRUSTED_MODE=on
# APPIUM_MCP_TRUSTED_OPS=app.clear,app.uninstall      # from: app.uninstall, app.clear, session.fullReset, file.push, provider.upload
# APPIUM_MCP_TRUSTED_APPS=com.example.testapp         # exact ids, no wildcards
# APPIUM_MCP_TRUSTED_REASON=nightly CI on a disposable emulator

# --- Workflows ----------------------------------------------------------------
# Where recorded workflows are saved (default: a temp folder).
# APPIUM_MCP_WORKFLOWS_DIR=
# Value substituted for the SECRET placeholder when a workflow is replayed (recordings never store passwords).
# APPIUM_MCP_SECRET=

# --- Integration tests and benchmark ------------------------------------------
# Device tests: see src/tests/integration/README.md
# INTEGRATION_PLATFORM=android
# ANDROID_SERIAL=
# IOS_UDID=
# INTEGRATION_APP_ID=com.android.settings
# INTEGRATION_MIN_HOST_MB=1500
# INTEGRATION_MIN_GUEST_MB=600
# Token benchmark: with a key, npm run bench:tokens uses Anthropic's token-counting API; without it, a labelled proxy.
# ANTHROPIC_API_KEY=
# BENCH_MODEL=claude-sonnet-5-5

# --- Cloud providers (set only the ones you use) -------------------------------
# LambdaTest (TestMu AI)
# LAMBDATEST_USERNAME=
# LAMBDATEST_ACCESS_KEY=
# LAMBDATEST_REGION=us            # us | eu | ap (device list)

# BrowserStack App Automate
# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=

# Sauce Labs
# SAUCE_USERNAME=
# SAUCE_ACCESS_KEY=
# SAUCE_REGION=us-west-1          # us-west-1 | us-east-4 | eu-central-1 | asia-south-2

# Kobiton (partial support)
# KOBITON_USERNAME=
# KOBITON_API_KEY=
# KOBITON_HUB_URL=                # https URL from your Kobiton account docs, no credentials in it

# Optional: restrict which remote Appium hubs this server may contact (regex tested against the hub URL).
# REMOTE_SERVER_URL_ALLOW_REGEX=^https://(hub\.browserstack\.com|ondemand\..*\.saucelabs\.com|mobile-hub\.lambdatest\.com)/
